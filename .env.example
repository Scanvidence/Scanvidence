# Copy to .env and fill in real values. .env is gitignored — never commit it.

# IBM Quantum Open Plan (Section 5.3 / Resourcing)
IBM_QUANTUM_API_TOKEN=

# D-Wave Leap / LaunchPad
DWAVE_API_TOKEN=

# Experiment tracking
WANDB_API_KEY=
WANDB_PROJECT=scanvidence
MLFLOW_TRACKING_URI=

# Dataset access (log the access date here once approved, per the
# Datasets and Data Handling section's licensing/attribution requirement)

# Brain Tumor datasets
BRATS_DATA_ROOT=./data/raw/brats
TCGA_DATA_ROOT=./data/raw/tcga
FIGSHARE_DATA_ROOT=./data/raw/figshare

# Alzheimer's datasets
ADNI_DATA_ROOT=./data/raw/adni
OASIS_DATA_ROOT=./data/raw/oasis
